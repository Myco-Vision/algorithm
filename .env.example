# Algorithm / ML Service Configuration

# Shared secret key between Laravel (api) and Flask (algorithm) for retraining endpoints
RETRAIN_API_KEY=myco-retrain-secret

# Set to 1 for interactive debug mode in local development
FLASK_DEBUG=1

# --- Inference Thresholds & Calibration ---
# Stage 1: Edibility / Out-of-Distribution confidence gate (default: 0.75, range: 0.70 - 0.85)
MUSHROOM_CONFIDENCE_THRESHOLD=0.75

# Stage 2: Species catalog confidence gate (default: 0.65, nudge to 0.60 if borderline species get flagged as uncatalogued)
SPECIES_CONFIDENCE_THRESHOLD=0.65

# Probability calibration (temperature scaling to prevent overconfident softmax spikes)
CALIBRATION_TEMPERATURE=1.4
CALIBRATION_SMOOTHING=0.015
